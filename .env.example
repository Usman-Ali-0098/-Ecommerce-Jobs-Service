# Same Postgres database as the Next.js app (copy DATABASE_URL from its .env).
# This service only reads/writes rows in tables Prisma owns — it never runs
# migrations against them.
#
# If the Next.js .env value has "sslmode=verify-full&channel_binding=require"
# (Neon's default), change it to "sslmode=require" and drop channel_binding
# here — psycopg2-binary's bundled OpenSSL can't find a usable root CA store
# on macOS, so verify-full fails with "unable to get local issuer
# certificate". require still encrypts the connection, just skips strict
# server-certificate-chain verification.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"


# Redis, e.g. via `docker compose up -d`
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# How often (seconds) Celery Beat scans for expired orders. Orders become
# eligible once their own Order.paymentRetryExpiresAt deadline passes (set
# by the Next.js app at order creation) — this is only how often the sweep
# checks for that, not the deadline itself.
SWEEP_INTERVAL_SECONDS=120

# Same value as the Next.js app's own APP_URL — used to link back to it
# (e.g. the "Reorder" link in the cancellation email).
APP_URL="http://localhost:3000"

# Same Gmail SMTP account as the Next.js app's .env (SMTP_* / EMAIL_FROM there).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="user@gmail.com"
SMTP_PASSWORD="app-password"
EMAIL_FROM="Your Store <user@gmail.com>"

# Shared secret the Next.js app sends as "Authorization: Bearer <this>" on
# every request to this service. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Same value goes in the Next.js .env as JOBS_API_SECRET.
JOBS_API_SECRET="generate-a-random-secret"

# Google AI Studio API key (free tier, no billing account required).
# Create one at https://aistudio.google.com/apikey — used only to call
# gemini-embedding-001 when indexing KnowledgeChunk rows for the chatbot's
# RAG search.
GEMINI_API_KEY="get-this-from-aistudio.google.com"

# Bulk CSV imports. The image directory must be a durable shared mount visible to every worker.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
BULK_UPLOAD_IMAGES_DIR=./bulk-upload-images
BULK_UPLOAD_MAX_CSV_BYTES=52428800
BULK_UPLOAD_MAX_ROWS=10000
BULK_UPLOAD_MAX_PRODUCTS=500
